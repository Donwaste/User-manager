{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || auth.uid === 'Zy5rsjA0USO4dycrjaJcLcPVmjX2') && ($uid !== 'Zy5rsjA0USO4dycrjaJcLcPVmjX2' || newData.exists())",
        ".validate": "newData.hasChildren(['_id', 'email', 'name'])",
        "_id": { ".validate": "newData.val() === $uid" },
        "email": {
          ".validate": "newData.isString() && (auth.uid === 'Zy5rsjA0USO4dycrjaJcLcPVmjX2' || newData.val().toLowerCase() === auth.token.email.toLowerCase())"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "profession": { ".validate": "newData.isString()" },
        "sex": {
          ".validate": "newData.val() === 'male' || newData.val() === 'female' || newData.val() === 'other'"
        },
        "license": { ".validate": "newData.isBoolean()" },
        "rate": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && (!data.exists() || newData.val() === data.val() || auth.uid === 'Zy5rsjA0USO4dycrjaJcLcPVmjX2')"
        },
        "completedMeetings": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val() || auth.uid === 'Zy5rsjA0USO4dycrjaJcLcPVmjX2')"
        },
        "qualities": { ".validate": "newData.hasChildren()" },
        "bookmarks": { "$id": { ".validate": "newData.isBoolean()" } },
        "$other": { ".validate": false }
      }
    },
    "qualities": {
      ".read": true,
      ".write": false
    },
    "professions": {
      ".read": true,
      ".write": false
    },
    "comments": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'Zy5rsjA0USO4dycrjaJcLcPVmjX2'",
      ".indexOn": ["pageId"],
      "$cid": {
        ".write": "auth != null && (data.exists() ? data.child('userId').val() === auth.uid : true) && (!newData.exists() || newData.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['_id', 'userId', 'pageId', 'content', 'created_at'])",
        "_id": { ".validate": "newData.val() === $cid" },
        "userId": { ".validate": "newData.isString()" },
        "pageId": { ".validate": "newData.isString()" },
        "content": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "created_at": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
